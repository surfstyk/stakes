# Stakes treasury (custody) NIM address — stakes are sent here when a user joins.
# Use a testnet NQ... address while testing. Copy this file to .env.local (git-ignored)
# and fill in the value. Leave empty to keep the app on the mock vault.
#
# This same address is read by the API (server/verify.ts) to confirm stake deposits
# landed on-chain. The API needs only the public ADDRESS — never the treasury key.
VITE_TREASURY_NIM_ADDRESS=

# --- API deposit verification (server-side, optional) ---
# Chain RPC the API reads to verify deposits. Defaults to the nimiqscan testnet node;
# set to the mainnet node for the public flip. (Read-only; no key involved.)
# STAKES_RPC_URL=https://rpc-testnet.nimiqscan.com/
#
# Optional override if the verify treasury address differs from VITE_TREASURY_NIM_ADDRESS.
# STAKES_TREASURY_ADDRESS=
#
# Treasury private key — used ONLY by the offline settlement job (server/settle.ts),
# NEVER by the API. Keep it off any internet-facing box (see surfstyk-notes/DEPLOYMENT.md).
# TREASURY_KEYPAIR_HEX=

# --- The stamp address (Cycle II: "let's make some noise, on-chain") ---
# Every check-in sends a free NIM dust tx from the USER'S wallet to this address, tagged
# `stakes.day day:<id>:<n>`. Separate from the treasury so its explorer page is the live feed.
# Required in a real-money build (the app refuses to fake a stamp when a treasury is set).
VITE_STAMP_ADDRESS=
# Dust per stamp, in luna (default 1).
# VITE_STAMP_VALUE_LUNA=1
# The stamp address key — NOT needed by the app or the API; only to recycle dust later.
# STAMP_KEYPAIR_HEX=

# --- The seed (treasury → new wallet at "Start day one"; server side, isolated settle service) ---
# Luna per seed (default 10000 = 0.1 NIM, ~a month of dust stamps). Daily cap = max seeds/day.
# STAKES_SEED_LUNA=10000
# STAKES_SEED_DAILY_CAP=500
# STAKES_SEED_PER_IP_DAILY=20
# STAKES_SEED_OFF=1        # kill switch: stop seeding (stamps defer until the wallet has NIM)

# --- The finisher-bonus guard (settle service only; audit H1) ---
# One bonus per wallet per cooldown, and a global daily bonus budget. Principal is always paid
# back in full; only the bonus line is withheld when a guard trips.
# STAKES_BONUS_WALLET_COOLDOWN_MS=86400000
# STAKES_BONUS_DAILY_CAP_NIM=1000
