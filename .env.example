# Stakes treasury (custody) NIM address — stakes are sent here when a user joins.
# Use a testnet NQ... address while testing. Copy this file to .env.local (git-ignored)
# and fill in the value. Leave empty to keep the app on the mock vault.
#
# This same address is read by the API (server/verify.ts) to confirm stake deposits
# landed on-chain. The API needs only the public ADDRESS — never the treasury key.
VITE_TREASURY_NIM_ADDRESS=

# --- API deposit verification (server-side, optional) ---
# Chain RPC the API reads to verify deposits. Defaults to the nimiqscan testnet node;
# set to the mainnet node for the public flip. (Read-only; no key involved.)
# STAKES_RPC_URL=https://rpc-testnet.nimiqscan.com/
#
# Optional override if the verify treasury address differs from VITE_TREASURY_NIM_ADDRESS.
# STAKES_TREASURY_ADDRESS=
#
# Treasury private key — used ONLY by the offline settlement job (server/settle.ts),
# NEVER by the API. Keep it off any internet-facing box (see surfstyk-notes/DEPLOYMENT.md).
# TREASURY_KEYPAIR_HEX=
